{
  "providers": {
    "gemini-lite": {
      "id": "gemini-lite",
      "label": "Gemini 3.5 Flash Lite",
      "kind": "gemini",
      "model": "gemini-3.5-flash-lite",
      "env": "GEMINI_API_KEY",
      "enabled": true,
      "private_ok": false,
      "daily_tokens": 1000000
    },
    "gemini-flash": {
      "id": "gemini-flash",
      "label": "Gemini 3.5 Flash",
      "kind": "gemini",
      "model": "gemini-3.5-flash",
      "env": "GEMINI_API_KEY",
      "enabled": true,
      "private_ok": false,
      "daily_tokens": 250000
    },
    "agy": {
      "id": "agy",
      "label": "Antigravity CLI",
      "kind": "cli",
      "cmd": [
        "agy",
        "-p",
        "{prompt}"
      ],
      "enabled": true,
      "private_ok": false
    },
    "claude-haiku": {
      "id": "claude-haiku",
      "label": "Claude Haiku",
      "kind": "cli",
      "cmd": [
        "claude",
        "-p",
        "{prompt}",
        "--model",
        "haiku"
      ],
      "enabled": true,
      "private_ok": true
    },
    "claude-sonnet": {
      "id": "claude-sonnet",
      "label": "Claude Sonnet",
      "kind": "cli",
      "cmd": [
        "claude",
        "-p",
        "{prompt}",
        "--model",
        "sonnet"
      ],
      "enabled": true,
      "private_ok": true
    },
    "ollama": {
      "id": "ollama",
      "label": "Ollama local",
      "kind": "ollama",
      "base_url": "http://localhost:11434",
      "model": "qwen2.5-coder:3b",
      "need_key": false,
      "enabled": true,
      "private_ok": true,
      "keep_alive": "30s",
      "num_ctx": 4096,
      "min_free_gb": 2.5
    },
    "codex": {
      "id": "codex",
      "label": "Codex (ChatGPT)",
      "kind": "cli",
      "cmd": [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "-s",
        "read-only",
        "{prompt}"
      ],
      "enabled": true,
      "private_ok": true
    },
    "claude-opus": {
      "id": "claude-opus",
      "label": "Claude Opus 5.5",
      "kind": "cli",
      "cmd": [
        "claude",
        "-p",
        "{prompt}",
        "--model",
        "claude-opus-5-5"
      ],
      "enabled": true,
      "private_ok": true,
      "timeout": 300
    }
  },
  "roles": {
    "leer": {
      "private": false,
      "chain": [
        "gemini-lite",
        "agy",
        "ollama",
        "claude-haiku"
      ]
    },
    "mecanico": {
      "private": false,
      "chain": [
        "gemini-lite",
        "gemini-flash",
        "agy",
        "ollama",
        "claude-haiku"
      ]
    },
    "ask": {
      "private": false,
      "chain": [
        "gemini-flash",
        "agy",
        "ollama",
        "claude-haiku"
      ]
    },
    "planear": {
      "private": true,
      "chain": [
        "claude-opus",
        "codex",
        "claude-sonnet",
        "ollama",
        "agy"
      ]
    },
    "revisar": {
      "private": true,
      "chain": [
        "codex",
        "claude-sonnet",
        "ollama",
        "agy"
      ]
    }
  }
}